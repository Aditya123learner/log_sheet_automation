  {
   "fieldname": "google_service_account_key",
   "fieldtype": "Password",
   "label": "Google Service Account Key (JSON)",
   "description": "Paste the FULL contents of the service account key JSON file here (from Google Cloud Console -> IAM & Admin -> Service Accounts -> Keys). Stored encrypted in this site's database, never in source control. The service account needs the \"Cloud Vision AI User\" role (or broader, e.g. Editor) on the project, and the Cloud Vision API must be enabled for that project. This is the only field needed for OCR \u2014 Vision API has no per-project processor to configure, unlike Document AI.",
   "depends_on": "eval:doc.ocr_provider_mode=='Google Vision API'",
   "idx": 11,
   "reqd": 0,
   "hidden": 0
  },
  {
   "fieldname": "ocr_field_label_patterns",
   "label": "OCR Field Label Patterns (JSON)",
   "fieldtype": "Code",
   "options": "JSON",
   "default": "{\n  \"working_hours\": [\n    \"working\\\\s*hours?\",\n    \"work\\\\s*hrs?\\\\.?\",\n    \"w\\\\.?\\\\s*hrs?\\\\.?\"\n  ],\n  \"idle_hours\": [\n    \"idle\\\\s*hours?\",\n    \"idle\\\\s*hrs?\\\\.?\"\n  ],\n  \"standby_hours\": [\n    \"stand\\\\s*-?\\\\s*by\\\\s*hours?\",\n    \"standby\\\\s*hrs?\\\\.?\"\n  ],\n  \"breakdown_hours\": [\n    \"break\\\\s*-?\\\\s*down\\\\s*hours?\",\n    \"breakdown\\\\s*hrs?\\\\.?\",\n    \"b\\\\.?d\\\\.?\\\\s*hrs?\\\\.?\"\n  ]\n}",
   "description": "How Google Vision's raw recognized text gets matched to each of the four hour fields, as {\"field_name\": [\"regex pattern\", ...]}. Edit this once you have a real filled-in log sheet and know its actual printed label wording \u2014 no code change/deploy needed. Leave a field out (or leave this whole box blank) to fall back to the built-in default patterns in integrations/ocr.py. To see what Vision actually recognized on a real run (so you know what to match against), check the \"OCR Completed\" entry in that log sheet's own audit trail \u2014 it includes the raw text.",
   "idx": 12,
   "reqd": 0,
   "hidden": 0
  },
